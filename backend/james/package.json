{
  "name": "james",
  "version": "1.21.205",
  "description": "",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "postbuild": "node scripts/check-build.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "typecheck": "tsc --noEmit --incremental false",
    "db:create": "node scripts/database.cjs create",
    "db:seed": "node scripts/database.cjs seed",
    "db:seed:restaurant": "node scripts/seed-restaurant.cjs",
    "db:check": "node scripts/database.cjs check",
    "db:setup": "npm run build && npm run db:create && npm run migration:run && npm run db:seed && npm run db:check",
    "migration:generate": "node node_modules/typeorm/cli.js migration:generate -d dist/database/data-source.js",
    "migration:run": "node node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:show": "node node_modules/typeorm/cli.js migration:show -d dist/database/data-source.js",
    "migration:revert": "node node_modules/typeorm/cli.js migration:revert -d dist/database/data-source.js",
    "test:db": "node scripts/test-database.cjs",
    "test:local": "node scripts/test-local-api.cjs",
    "test:restaurant": "node scripts/test-restaurant.cjs",
    "test:courier": "node scripts/test-courier.cjs",
    "local:start": "npm run build && node scripts/local-server.cjs start",
    "local:stop": "node scripts/local-server.cjs stop",
    "local:status": "node scripts/local-server.cjs status",
    "verify": "npm run build && npm run typecheck && npm run lint && npm test -- --runInBand && npm run test:e2e -- --runInBand",
    "lint:fix": "npm run lint -- --fix",
    "db:seed:courier": "node scripts/seed-courier.cjs",
    "db:seed:catalog": "node scripts/seed-catalog.cjs",
    "test:catalog": "node scripts/test-catalog.cjs"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/typeorm": "12.0.2",
    "@nestjs/websockets": "12.3.2",
    "axios": "^1.21.0",
    "bcrypt": "6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "firebase-admin": "14.5.0",
    "google-auth-library": "11.3.1",
    "nodemailer": "10.2.1",
    "passport": "0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "qs": "^6.17.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/passport-jwt": "4.0.1",
    "@types/qs": "^6.15.1",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "rimraf": "^5.0.10",
    "source-map-support": "^0.5.21",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@parcel/watcher@2.6.0": false,
    "unrs-resolver@1.12.2": false,
    "@firebase/util@1.15.3": false,
    "protobufjs@7.6.6": false
  }
}
