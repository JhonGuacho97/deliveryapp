# Copy to .env and use resources belonging to your development environment.
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=delivery
DB_PASSWORD=replace-with-a-local-password
DB_NAME=delivery
# Keep false for existing databases. No schema migrations run automatically.
DB_SYNCHRONIZE=false

# Set false for an offline local environment (no Firebase, email, Stripe or Places).
EXTERNAL_SERVICES_ENABLED=true

# JWT_SECREAT remains accepted for compatibility with existing deployments.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Supply your own service account JSON and OAuth mail configuration.
APP_NAME=Delivery App
# Use a sender address authorized by your mail provider.
MAIL_FROM=Delivery App <sender@example.com>
FIREBASE_CREDENTIAL_JSON={"project_id":"replace-me","client_email":"replace-me","private_key":"replace-me"}
ACCOUNT_TRANSPORT={"service":"gmail","auth":{"type":"OAuth2","user":"replace-me","clientId":"replace-me","clientSecret":"replace-me","refreshToken":"replace-me"}}
STRIPE_SECRET_KEY=replace-with-your-test-secret-key

# Payment providers are independent from Firebase/email/Places.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=payphone
STRIPE_ENABLED=false
PAYPHONE_MODE=test
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
# Register http://localhost:3000 as the development domain in PayPhone Developer.
# HTTP loopback is allowed only in test mode. Production requires HTTPS.
PAYPHONE_RESPONSE_URL=http://localhost:3000/api/client/payments/payphone/return
API_KEY_GOOGLE=replace-with-your-key
